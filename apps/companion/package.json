{
  "name": "football-assistant-companion",
  "version": "0.0.1-alpha.1",
  "private": true,
  "description": "FootballAssistant MVP desktop companion",
  "author": "FootballAssistant contributors",
  "main": "src/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "check": "node --check src/main.cjs && node --check src/preload.cjs && node --check src/character.cjs && node --check src/renderer.js && node --check src/settings.js && npm test",
    "pack:mac": "electron-builder --mac dir --arm64 --publish never && node packaging/sign-mac-adhoc.cjs",
    "pack:win": "electron-builder --win nsis portable --x64 --publish never"
  },
  "devDependencies": {
    "@electron/osx-sign": "1.3.3",
    "electron": "45.1.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "local.footballassistant.companion",
    "productName": "FootballAssistant",
    "artifactName": "FootballAssistant-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "THIRD_PARTY.md",
      "package.json",
      "!**/.env*",
      "!**/runtime.json",
      "!**/local-data/**",
      "!**/local-game/**",
      "!**/*.db",
      "!**/*.sqlite*",
      "!**/*.log",
      "!**/*.fm",
      "!**/*.fms"
    ],
    "mac": {
      "target": [
        "dir"
      ],
      "category": "public.app-category.games",
      "identity": null,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "按住桌宠时使用麦克风，将你的语音转换成文字。"
      },
      "icon": "packaging/assets/icon.png"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "packaging/assets/icon.png",
      "signExecutable": false
    },
    "extraResources": [
      {
        "from": "../../build/desktop-backend/football-assistant-backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!**/.env*",
          "!**/runtime.json",
          "!**/*.log",
          "!**/local-data/**",
          "!**/local-game/**",
          "!**/*.db",
          "!**/*.sqlite*",
          "!**/*.fm",
          "!**/*.fms",
          "!**/model-config.json",
          "!**/credentials*.json",
          "!**/settings.json"
        ]
      }
    ],
    "nsis": {
      "artifactName": "FootballAssistant-${version}-Setup-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": false,
      "include": "packaging/installer.nsh"
    },
    "portable": {
      "artifactName": "FootballAssistant-${version}-Portable-${arch}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "sanshanhyo",
      "repo": "FootballAssistant",
      "releaseType": "prerelease"
    },
    "icon": "packaging/assets/icon.png"
  },
  "dependencies": {
    "electron-updater": "6.6.2"
  }
}
