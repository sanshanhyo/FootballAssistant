{
  "name": "football-assistant-companion",
  "version": "0.0.1-alpha.1",
  "private": true,
  "description": "FootballAssistant MVP desktop companion",
  "author": "FootballAssistant contributors",
  "main": "src/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "check": "node --check src/main.cjs && node --check src/preload.cjs && node --check src/character.cjs && node --check src/renderer.js && node --check src/settings.js && npm test",
    "pack:mac": "electron-builder --mac dir --arm64",
    "pack:win": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "local.footballassistant.companion",
    "productName": "FootballAssistant",
    "artifactName": "FootballAssistant-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "THIRD_PARTY.md",
      "package.json",
      "!**/.env*",
      "!**/runtime.json",
      "!**/local-data/**",
      "!**/local-game/**",
      "!**/*.db",
      "!**/*.sqlite*",
      "!**/*.log",
      "!**/*.fm",
      "!**/*.fms"
    ],
    "mac": {
      "target": [
        "dir"
      ],
      "category": "public.app-category.games",
      "identity": null,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "\u6309\u4f4f\u684c\u5ba0\u65f6\u4f7f\u7528\u9ea6\u514b\u98ce\uff0c\u5c06\u4f60\u7684\u8bed\u97f3\u8f6c\u6362\u6210\u6587\u5b57\u3002"
      }
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "extraResources": [
      {
        "from": "../../build/desktop-backend/football-assistant-backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!**/.env*",
          "!**/runtime.json",
          "!**/*.log",
          "!**/local-data/**",
          "!**/local-game/**",
          "!**/*.db",
          "!**/*.sqlite*",
          "!**/*.fm",
          "!**/*.fms",
          "!**/model-config.json",
          "!**/credentials*.json",
          "!**/settings.json"
        ]
      }
    ]
  }
}
