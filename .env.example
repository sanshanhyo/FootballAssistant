# Copy to .env locally. Never commit actual credentials.
# Use the existing OpenAI-compatible service chosen by the user.
FOOTBALL_ASSISTANT_BASE_URL=https://your-service.example/v1
FOOTBALL_ASSISTANT_MODEL=your-model-name
FOOTBALL_ASSISTANT_API_KEY=replace-with-your-key
# Blank TOKEN generates a new per-run token in local-data/runtime.json.
FOOTBALL_ASSISTANT_TOKEN=
FOOTBALL_ASSISTANT_PORT=17827
FOOTBALL_ASSISTANT_MODEL_TIMEOUT=45
# Optional absolute paths, with native platform separators:
# FOOTBALL_ASSISTANT_DATA_DIR=/path/to/private/local-data
# FOOTBALL_ASSISTANT_RUNTIME_FILE=/path/to/private/local-data/runtime.json
# Output limit applies to each real model request. No automatic SDK/Agent retries.
FOOTBALL_ASSISTANT_MAX_OUTPUT_TOKENS=180
# Optional provider-specific JSON, only after verifying its documentation:
FOOTBALL_ASSISTANT_MODEL_EXTRA_BODY={}
# 0 disables the hard request limit; use an explicit positive limit for paid tests.
FOOTBALL_ASSISTANT_MODEL_REQUEST_LIMIT=0
FOOTBALL_ASSISTANT_MODEL_BUDGET_ID=default
